<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="740.0" prefWidth="540.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mygame.RulesController">
   <children>
      <Button fx:id="backBtn" layoutX="369.0" layoutY="35.0" mnemonicParsing="false" onAction="#backToHello" prefHeight="43.0" prefWidth="143.0" text="Вернуться на главную" />
      <Label layoutX="162.0" layoutY="96.0" text="ПРАВИЛА ИГРЫ «ABOVE THE HEAVENS»" textAlignment="CENTER" />
      <Label layoutX="80.0" layoutY="128.0" text="О игре" />
      <Label layoutX="80.0" layoutY="153.0" prefHeight="93.0" prefWidth="385.0" text="Above the heavens — это бесконечный вертикальный платформер, в котором твой персонаж стремится подняться как можно выше над землёй. Чем выше ты поднимаешься, тем больше очков зарабатываешь. Твоя цель — побить собственный рекорд и не упасть." textAlignment="JUSTIFY" wrapText="true" />
      <Label layoutX="78.0" layoutY="260.0" text="Управление" />
      <Label layoutX="78.0" layoutY="297.0" prefHeight="165.0" prefWidth="385.0" text="Для движения влево и вправо используй клавиши A и D или стрелки на клавиатуре. Персонаж автоматически прыгает вверх, когда приземляется на платформу — тебе остаётся лишь направлять его в нужную сторону. Если ты выйдешь за левый или правый край экрана, персонаж появится с противоположной стороны. Чтобы выстрелить по врагу, нажми левую кнопку мыши. Между выстрелами есть небольшая пауза, так что целься внимательно. Клавиша Escape открывает меню паузы, откуда можно вернуться в главное меню." textAlignment="JUSTIFY" wrapText="true" />
      <ImageView fitHeight="61.0" fitWidth="49.0" layoutX="94.0" layoutY="547.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/enemy.png" />
         </image>
      </ImageView>
      <Label layoutX="162.0" layoutY="550.0" text="&lt;--">
         <font>
            <Font size="29.0" />
         </font>
      </Label>
      <Label layoutX="221.0" layoutY="507.0" prefHeight="137.0" prefWidth="243.0" text="Это враг. Он движется горизонтально, отражаясь от стен. Если он коснётся твоего персонажа — игра закончится немедленно. Ты можешь уничтожить врага выстрелом: за это ты получишь 100 бонусных очков. После уничтожения враг может появиться снова по мере дальнейшего подъёма." wrapText="true" />
      <ImageView fitHeight="49.0" fitWidth="49.0" layoutX="383.0" layoutY="236.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/Cube.png" />
         </image>
      </ImageView>
      <Label layoutX="325.0" layoutY="239.0" text="--&gt;">
         <font>
            <Font size="29.0" />
         </font>
      </Label>
      <Label layoutX="273.0" layoutY="252.0" text="Это ты" />
   </children>
</AnchorPane>
